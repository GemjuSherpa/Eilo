{
  "version": "2.0",
  "name": "Blue and light purple",
  "default_appearance": "system",
  "colors": {
    "light": {
      "gradient_start": "#DCEEFF",
      "gradient_end": "#E8DEFF",
      "surface": "#FFFFFF",
      "primary": "#2453C6",
      "text": "#172642",
      "secondary_text": "#43516A",
      "boundary": "#66748B",
      "error": "#B42335",
      "warning": "#805600"
    },
    "dark": {
      "gradient_start": "#101A30",
      "gradient_end": "#241B3D",
      "surface": "#18233B",
      "primary": "#B8CBFF",
      "text": "#F1F4FF",
      "secondary_text": "#C3CDE3",
      "boundary": "#91A4C7",
      "error": "#FFADB7",
      "warning": "#F2D080"
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "radius": {
    "control": 15,
    "card": 18,
    "sheet": 24
  },
  "typography": {
    "family": "system: SF Pro on iOS, Roboto/system on Android",
    "title": {
      "size": 32,
      "weight": 600,
      "line_height": 1.16
    },
    "section": {
      "size": 24,
      "weight": 600,
      "line_height": 1.3
    },
    "body": {
      "size": 16,
      "weight": 400,
      "line_height": 1.5
    },
    "label": {
      "size": 16,
      "weight": 600,
      "line_height": 1.3
    },
    "secondary": {
      "size": 14,
      "weight": 400,
      "line_height": 1.5
    },
    "caption": {
      "size": 12,
      "weight": 400,
      "line_height": 1.5
    }
  },
  "touch_target": {
    "shared_minimum": 48,
    "unit": "logical points/dp; prototype CSS px",
    "gap": 8
  },
  "motion": {
    "optional_state_transition_ms": 150,
    "initial_or_loop_animation": "Rounded outward ripple during listening/speaking only;1000ms initial loop",
    "reduced_motion": "static; preserve text state"
  },
  "accessibility": {
    "normal_text_min_contrast": 4.5,
    "essential_nontext_min_contrast": 3,
    "scaling": "native dynamic text; layout scrolls and wraps, no fixed-height text cards",
    "status": "text and optional shape/cue, never colour only"
  },
  "brand": {
    "name": "Eilo",
    "pronunciation": "AY-lo",
    "tagline": "I am here for you",
    "status": "owner_accepted_design_scope",
    "availability": "not_cleared"
  },
  "revision_date": "2026-10-05",
  "supersedes": "Prior warm-neutral/teal palette; historical checks do not validate this revision",
  "visual_interaction": {
    "loop_ms": 1000,
    "default_card_idle_ms": 20000,
    "conversation_idle_ms": 60000,
    "text_default": true,
    "images_default": false,
    "videos_default": false,
    "reduced_motion": "static mark and explicit state",
    "navigation": [
      "Home",
      "Memory",
      "Settings"
    ]
  }
